    "Was beim Start vorgewählt ist. Wählst du im Player etwas anderes, merkt sich Lumen das — im Browser und in allen Apps." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was beim Start vorgewählt ist. Wählst du im Player etwas anderes, merkt sich Lumen das — im Browser und in allen Apps."
          }
        },
        "de-AT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was beim Start vorgewählt ist. Wählst du im Player etwas anderes, merkt sich Lumen das — im Browser und in allen Apps."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What’s selected when playback starts. If you choose something else in the player, Lumen remembers it — in the browser and in all apps."
          }
        },
