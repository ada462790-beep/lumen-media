    "Läuft im Fenster eine Wiedergabe, wartet Lumen und versucht es später nochmal." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läuft im Fenster eine Wiedergabe, wartet Lumen und versucht es später nochmal."
          }
        },
        "de-AT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läuft im Fenster eine Wiedergabe, wartet Lumen und versucht es später nochmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If something is playing in the time window, Lumen waits and tries again later."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If something is playing in the time window, Lumen waits and tries again later."
          }
        }
      }
    },
    "Läuft im Fenster eine Wiedergabe, wartet Lumen und versucht es später nochmal. Im Container aktualisiert man das Abbild von aussen — darum ist das hier aus." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läuft im Fenster eine Wiedergabe, wartet Lumen und versucht es später nochmal. Im Container aktualisiert man das Abbild von außen — darum ist das hier aus."
          }
        },
        "de-AT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läuft im Fenster eine Wiedergabe, wartet Lumen und versucht es später nochmal. Im Container aktualisiert man das Abbild von außen — darum ist das hier aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If something is playing in the time window, Lumen waits and tries again later. In a container, the image is updated from outside — that’s why this is turned off."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If something is playing in the time window, Lumen waits and tries again later. In a container, the image is updated from outside — that’s why this is turned off."
          }
        }
      }
    },
    "Läuft im Hintergrund. Schau später wieder herein." : {
