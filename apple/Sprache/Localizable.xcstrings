    "Ein Wunsch ist das, was jemand dir ausdrücklich sagt. Was er sonst schaut, steht hier nicht — und nirgends sonst." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Wunsch ist das, was jemand dir ausdrücklich sagt. Was er sonst schaut, steht hier nicht — und nirgends sonst."
          }
        },
        "de-AT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Wunsch ist das, was jemand dir ausdrücklich sagt. Was er sonst schaut, steht hier nicht — und nirgends sonst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A request is something someone tells you explicitly. What else they watch isn’t shown here — or anywhere else."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A request is something someone tells you explicitly. What else they watch isn’t shown here — or anywhere else."
          }
        }
      }
    },
    "Ein eigener PIN, ein Passwort oder ein Code aus einer Authenticator-App vor der Verwaltung — damit niemand, der dein Gerät in der Hand hat, am Server herumstellt." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein eigener PIN, ein Passwort oder ein Code aus einer Authenticator-App vor der Verwaltung — damit niemand, der dein Gerät in der Hand hat, am Server herumstellt."
          }
        },
        "de-AT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein eigener PIN, ein Passwort oder ein Code aus einer Authenticator-App vor der Verwaltung — damit niemand, der dein Gerät in der Hand hat, am Server herumstellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A separate PIN, password or code from an authenticator app in front of Admin — so nobody holding your device can change settings on the server."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A separate PIN, password or code from an authenticator app in front of Admin — so nobody holding your device can change settings on the server."
          }
        }
      }
    },
