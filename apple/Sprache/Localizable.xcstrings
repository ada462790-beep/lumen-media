    "Wer in einer Gruppe ist, bekommt deren Bibliotheken und Grenzen; die eigenen Einträge am Konto ruhen solange. Was jemand schaut, sieht keine Gruppe — auch keine mit Verwaltung." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer in einer Gruppe ist, bekommt deren Bibliotheken und Grenzen; die eigenen Einträge am Konto ruhen solange. Was jemand schaut, sieht keine Gruppe — auch keine mit Verwaltung."
          }
        },
        "de-AT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer in einer Gruppe ist, bekommt deren Bibliotheken und Grenzen; die eigenen Einträge am Konto ruhen solange. Was jemand schaut, sieht keine Gruppe — auch keine mit Verwaltung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone in a group gets its libraries and limits; their own account settings are paused meanwhile. No group can see what anyone watches — not even one with admin rights."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone in a group gets its libraries and limits; their own account settings are paused meanwhile. No group can see what anyone watches — not even one with admin rights."
          }
        }
      }
    },
