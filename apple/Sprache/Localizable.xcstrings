    "Eine Liste sieht nur, wer sie angelegt hat — bis sie geteilt wird. Auch der Besitzer des Servers sieht sie vorher nicht." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Liste sieht nur, wer sie angelegt hat — bis sie geteilt wird. Auch der Besitzer des Servers sieht sie vorher nicht."
          }
        },
        "de-AT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Liste sieht nur, wer sie angelegt hat — bis sie geteilt wird. Auch der Besitzer des Servers sieht sie vorher nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the person who created a list can see it — until it’s shared. Not even the server’s owner can see it before then."
          }
        },
