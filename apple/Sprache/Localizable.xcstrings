    "Verwaltet mit: Bibliotheken prüfen, Konten ohne Verwaltung, Wünsche, Protokoll. Vollzugriff: alles wie der Besitzer — auch Gruppen, Rechte, Updates und Sicherungen. Wer was schaut, sieht niemand." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwaltet mit: Bibliotheken prüfen, Konten ohne Verwaltung, Wünsche, Protokoll. Vollzugriff: alles wie der Besitzer — auch Gruppen, Rechte, Updates und Sicherungen. Wer was schaut, sieht niemand."
          }
        },
        "de-AT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwaltet mit: Bibliotheken prüfen, Konten ohne Verwaltung, Wünsche, Protokoll. Vollzugriff: alles wie der Besitzer — auch Gruppen, Rechte, Updates und Sicherungen. Wer was schaut, sieht niemand."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co-admin: check libraries, accounts without admin rights, requests, log. Full access: everything the owner can do — including groups, permissions, updates and backups. Nobody can see who watches what."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co-admin: check libraries, accounts without admin rights, requests, log. Full access: everything the owner can do — including groups, permissions, updates and backups. Nobody can see who watches what."
          }
        }
      }
    },
