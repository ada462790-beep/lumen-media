<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Ein Fernseher hat keinen Berührungsbildschirm; ohne diese Zeile
         lässt sich die App im Play Store nicht als TV-App führen. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="true" />

    <application
        android:name="org.lumen.tv.LumenTvApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:fullBackupContent="@xml/sicherung_alt"
        android:dataExtractionRules="@xml/sicherung_regeln"
        android:theme="@style/Theme.LumenTv"
        android:networkSecurityConfig="@xml/network_security_config"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="34">

        <!-- Zur festen Ausrichtung: Lint rät allgemein davon ab, weil eine
             App auf einem Gerät, das man drehen kann, sonst in einem Rahmen
             klebt. Ein Fernseher lässt sich nicht drehen. -->
        <activity
            android:name="org.lumen.tv.TvActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.LumenTv"
            tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- LEANBACK_LAUNCHER bringt die App auf den Startbildschirm
                     von Android TV und Fire TV. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
